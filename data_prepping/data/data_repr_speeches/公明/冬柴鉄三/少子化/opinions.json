            "speech_url": "https://kokkai.ndl.go.jp/txt/116914372X00220080424/44",
            "speaker_group": "公明党",
            "extracted_opinions": [
                "\r\n　そういう意味で、これは今、日本が高齢社会を通り越して今人口減少社会に入ろうとしています"
            ]
        },
        {
            "speech_id": "116914319X00220080327_007",
