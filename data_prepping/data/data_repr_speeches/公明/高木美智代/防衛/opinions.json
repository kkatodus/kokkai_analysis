            "house_name": "衆議院",
            "meeting_name": "経済産業委員会",
            "date": "2017-04-19",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119304080X00920170419/28",
            "speaker_group": "公明党",
            "extracted_opinions": [
