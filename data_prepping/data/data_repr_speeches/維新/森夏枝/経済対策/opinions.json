            "speech_id": "119605007X01820180530_134",
            "house_name": "衆議院",
            "meeting_name": "農林水産委員会",
            "date": "2018-05-30",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119605007X01820180530/134",
            "speaker_group": "日本維新の会",
            "extracted_opinions": [
                "食品ロスの削減には消費者の理解が必要だと思います"
