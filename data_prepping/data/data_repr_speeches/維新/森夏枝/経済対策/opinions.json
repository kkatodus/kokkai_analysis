            "house_name": "衆議院",
            "meeting_name": "農林水産委員会",
            "date": "2019-03-07",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119805007X00220190307/261",
            "speaker_group": "日本維新の会",
