        },
        {
            "speech_id": "119605007X01820180530_136",
            "house_name": "衆議院",
            "meeting_name": "農林水産委員会",
            "date": "2018-05-30",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119605007X01820180530/136",
            "speaker_group": "日本維新の会",
            "extracted_opinions": [
                "消費者の理解を得ることや、行政として消費者団体との連携も必要だと思います"
