            "speech_id": "119605007X01920180531_118",
            "house_name": "衆議院",
            "meeting_name": "農林水産委員会",
            "date": "2018-05-31",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119605007X01920180531/118",
            "speaker_group": "日本維新の会",
            "extracted_opinions": [
                "\r\n　消費者の立場で農薬について考えますと、安全性が最も考慮されるべきポイントだと思います"
