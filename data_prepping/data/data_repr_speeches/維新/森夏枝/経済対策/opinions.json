        },
        {
            "speech_id": "119605007X02120180607_112",
            "house_name": "衆議院",
            "meeting_name": "農林水産委員会",
            "date": "2018-06-07",
            "speech_url": "https://kokkai.ndl.go.jp/txt/119605007X02120180607/112",
            "speaker_group": "日本維新の会",
            "extracted_opinions": [
                "\r\n　日本維新の会は、規制緩和を断行し、新たな民間活力を育成し、産業の振興と経済の活性化を図ることを党の政策の柱に据えており、ぜひしっかりとした改革を進めていっていただきたいと思っておりますが、現在、どのような内容の改革を目指し検討が行われているのでしょうか"
