            "house_name": "参議院",
            "meeting_name": "農林水産委員会",
            "date": "2004-06-03",
            "speech_url": "https://kokkai.ndl.go.jp/txt/115915007X01920040603/32",
            "speaker_group": null,
            "extracted_opinions": [
