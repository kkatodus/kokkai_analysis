{
 "topic": "socialsecurity",
 "axis_notes": {
  "sustainability": "ILL-DEFINED: both statements favour reform and sparing the working generation; read as pro = prioritise sustainability reforms (restraint/efficiency/burden restructuring), con = resist cuts/burden-raising reviews",
  "benefitburdenbalance": "pro = clear benefit-burden link and fair burden-sharing across/within generations (ability-based, elderly pay their share); con = oppose burden increases on patients/elderly/low-income as unfair",
  "consumptionhaxforsocialsecurity": "pro = support consumption tax (and its hikes) as social security funding; con = oppose hikes / call it unsuitable or want cuts",
  "longtermdareinsurancereform": "ILL-DEFINED: pro says 'enhance LTC', con says 'reforms may lower quality' (opposition wants both); read as pro = supportive of LTC insurance reform/review direction, con = critical of reforms as cutting benefits/raising user burden",
  "younggenerationburden": "ILL-DEFINED: both statements favour relieving young/working generation; read as pro = prioritise relieving young/working-generation burden (shift from elderly-centred system), con = resist shifting burden onto elderly / reject elderly-vs-young framing"
 },
