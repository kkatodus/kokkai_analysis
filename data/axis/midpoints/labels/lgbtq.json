{
 "topic": "lgbtq",
 "axis_notes": {
  "samesexmarriage": "pro = supports legalising same-sex marriage; con = opposes or 'extremely cautious' govt line amounting to not introducing",
  "antidiscriminationlaw": "pro = supports enacting an LGBT anti-discrimination or understanding-promotion law (incl. wanting a stronger one); con = opposes new law / existing law suffices",
  "constitution24": "pro = Art.24 does not bar same-sex marriage (13/14 support it); con = Art.24 presumes opposite-sex marriage ('想定していない')",
  "publicunderstanding": "pro = legislate now, don't wait for consensus; con = wait for national consensus/understanding, watch trends",
  "internationalimpact": "pro = cites G7/international standards or economic costs as reason to act; con = domestic matter, no need to follow foreign pressure",
  "transgendertoilet": "pro = gender-identity-based facility use fine / safety fears unfounded; con = body-based separation or safety concerns take priority",
  "religiousinfluence": "pro = religious groups (ex-Unification Church) distorted policy, must be cut off; con = influence overstated",
  "selectivesurname": "pro = supports introducing selective separate surnames; con = opposes",
  "participationrights": "pro = law should mandate LGBT stakeholder participation / reasonable accommodation; con = against detailed mandates",
  "foreignspouse": "pro = grant residence status to foreign same-sex spouses; con = not uniformly, case-by-case suffices"
 },
