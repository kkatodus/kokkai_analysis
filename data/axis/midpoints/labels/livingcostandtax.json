{
 "topic": "livingcostandtax",
 "axis_notes": {
  "taxreductionmeasures": "pro = supports tax cuts (esp. consumption-tax cut) as a cost-of-living measure; con = opposes/cautious on tax cuts for fiscal reasons; opposing consumption-tax cut while backing a one-off income-tax cut = neutral",
  "wageincreasepromotion": "pro = wants wage rises actively promoted/supported by policy; con = caution because of the burden on firms; doubts about specific tools (wage tax credit) alone are not con",
  "consumptionhaxincrease": "pro = defends/raises consumption tax as stable social-security revenue; con = opposes consumption-tax increases or wants it cut",
  "smallbusinesssupport": "ILL-DEFINED: con statement still calls for (better) SME support; read as pro = calls for SME support, con = skeptical of/opposes SME support; criticism of big-firm favouritism counted as pro"
 },
