 "axis_notes": {
  "smallbusinesssupport": "pro = strengthen SME support (funding, price pass-through, subsidies); con = selective/limited support, avoid propping up uncompetitive firms or excessive intervention.",
  "consumptiontaxreduction": "pro = cut/abolish consumption tax or clearly oppose hikes on regressivity/demand grounds; con = support raising/maintaining it as social-security revenue; conditional/mixed = neutral.",
  "foreignworkers": "pro = expand acceptance of foreign workers; con = cautious/restrictive. Rarely addressed in economy summaries.",
  "monetarypolicyreview": "Inverted framing: pro = review/normalise/exit easing (side effects, weak yen); con = maintain or strengthen easing / avoid hasty rate hikes.",
  "governmentintervention": "pro = active state role (fiscal stimulus, industrial policy, public works, labour/market regulation); con = deregulation, structural reform, private-led, fiscal restraint over stimulus."
