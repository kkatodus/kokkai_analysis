{
 "topic": "pension",
 "axis_notes": {
  "basicpensionsubsidy": "pro = supports raising/securing the state (tax) share of the basic pension (1/3 -> 1/2 or more), even if objecting to a particular tax source; con = doubts/opposes raising it on fiscal grounds",
  "basicpensionbottomup": "pro = wants basic pension level raised/protected (stop macro slide on basic pension, minimum-guarantee top-ups); con = holds current level adequate or opposes top-up schemes (e.g. tax-funded minimum pension) for fiscal reasons",
  "employeespensionissue": "pro = extend employees' pension coverage (part-timers, unenrolled firms); con = resists expansion (burden on firms etc.); support conditional mainly on SME burden = neutral",
  "pensionsystemunification": "pro = supports unifying schemes (KNK/kyosai, or all incl. national pension); con = cautious/opposed to unification",
  "pensionreformtransparency": "ILL-DEFINED: both statements call for transparency; read as pro = constructive call for clearer explanation/information to restore trust, con = accuses reform process of being opaque/untrustworthy (misleading figures, forced votes, hidden decisions)"
 },
