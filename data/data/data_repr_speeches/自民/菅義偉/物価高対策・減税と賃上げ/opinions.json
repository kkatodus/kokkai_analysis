        },
        {
            "speech_id": "116604601X00620070301_049",
            "house_name": "衆議院",
            "meeting_name": "総務委員会",
            "date": "2007-03-01",
            "speech_url": "https://kokkai.ndl.go.jp/txt/116604601X00620070301/49",
            "speaker_group": "自由民主党",
            "extracted_opinions": [
                "○菅国務大臣　まず、この譲渡益課税また配当に係る軽減税率についての延長でありますけれども、株式市場だとか経済全体の情勢への影響、そういう中で延長をされたというふうに思っています"
            ]
        },
        {
            "speech_id": "116605272X00120070228_229",
