        },
        {
            "speech_id": "116605261X01420070223_054",
            "house_name": "衆議院",
            "meeting_name": "予算委員会",
            "date": "2007-02-23",
            "speech_url": "https://kokkai.ndl.go.jp/txt/116605261X01420070223/54",
            "speaker_group": "自由民主党",
            "extracted_opinions": [
                "\r\n　いずれにしろ、財政的には、やはり地方消費税等で偏在の少ないものにしていかなきゃならないというふうに思っています"
