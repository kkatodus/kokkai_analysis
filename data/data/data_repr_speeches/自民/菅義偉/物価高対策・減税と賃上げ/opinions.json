        {
            "speech_id": "116605261X01220070220_034",
            "house_name": "衆議院",
            "meeting_name": "予算委員会",
            "date": "2007-02-20",
            "speech_url": "https://kokkai.ndl.go.jp/txt/116605261X01220070220/34",
