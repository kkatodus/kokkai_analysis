            "speaker_group": null,
            "extracted_opinions": [
                "○五十嵐参考人　御指摘のとおりでありまして、今の医療保険の中でかなりの部分が、福祉の問題についても給付がされているのであろうと私は思います"
            ]
        },
        {
            "speech_id": "112904237X00819940610_028",
            "house_name": "衆議院",
            "meeting_name": "厚生委員会",
