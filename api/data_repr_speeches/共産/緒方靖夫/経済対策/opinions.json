            "speech_id": "115414080X00720020404_145",
            "house_name": "参議院",
            "meeting_name": "経済産業委員会",
            "date": "2002-04-04",
            "speech_url": "https://kokkai.ndl.go.jp/txt/115414080X00720020404/145",
            "speaker_group": "日本共産党",
            "extracted_opinions": [
