        {
            "speech_id": "115404260X00920020417_217",
            "house_name": "衆議院",
            "meeting_name": "厚生労働委員会",
            "date": "2002-04-17",
            "speech_url": "https://kokkai.ndl.go.jp/txt/115404260X00920020417/217",
            "speaker_group": "日本共産党",
            "extracted_opinions": [
                "\r\n　私は、失業者や雇用保険受給者を大量につくり出した大企業に、もっと雇用保険料の負担を求めるべきだと思います",
