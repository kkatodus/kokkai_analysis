        },
        {
            "speech_id": "116904376X00420080220_033",
            "house_name": "衆議院",
            "meeting_name": "財務金融委員会",
            "date": "2008-02-20",
            "speech_url": "https://kokkai.ndl.go.jp/txt/116904376X00420080220/33",
            "speaker_group": "自由民主党",
